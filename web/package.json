{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-skills-bundle.mjs && node scripts/bundle-skills.mjs && node scripts/bundle-agent.mjs && next dev",
    "build": "node scripts/opennext.mjs build",
    "start": "next start",
    "preview": "node scripts/opennext.mjs build && node scripts/opennext.mjs preview",
    "deploy": "node scripts/opennext.mjs build && node scripts/opennext.mjs deploy",
    "upload": "node scripts/opennext.mjs build && node scripts/opennext.mjs upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply translate-agent --local",
    "typecheck": "tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.70",
    "@base-ui/react": "^1.9.0",
    "@langfuse/otel": "^6.0.2",
    "@langfuse/tracing": "^6.0.2",
    "@langfuse/vercel-ai-sdk": "^6.0.2",
    "@opennextjs/cloudflare": "^1.20.13",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/otlp-exporter-base": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@shadcn/react": "^0.3.1",
    "ai": "7.0.142",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "shiki": "^4.5.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.151.3"
  }
}
