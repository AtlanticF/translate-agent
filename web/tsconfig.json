{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "ai": ["./node_modules/ai"],
      "@ai-sdk/openai-compatible": ["./node_modules/@ai-sdk/openai-compatible"],
      "@mozilla/readability": ["./node_modules/@mozilla/readability"],
      "@langfuse/otel": ["./node_modules/@langfuse/otel"],
      "@langfuse/tracing": ["./node_modules/@langfuse/tracing"],
      "@langfuse/vercel-ai-sdk": ["./node_modules/@langfuse/vercel-ai-sdk"],
      "@opentelemetry/api": ["./node_modules/@opentelemetry/api"],
      "@opentelemetry/context-async-hooks": ["./node_modules/@opentelemetry/context-async-hooks"],
      "@opentelemetry/sdk-trace-base": ["./node_modules/@opentelemetry/sdk-trace-base"],
      "linkedom": ["./node_modules/linkedom"],
      "turndown": ["./node_modules/turndown"],
      "yaml": ["./node_modules/yaml"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": [
    "next-env.d.ts",
    "cloudflare-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "**/*.test.ts", "lib/session-sqlite.ts"]
}
