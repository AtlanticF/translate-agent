{
	"$schema": "web/node_modules/wrangler/config-schema.json",
	"name": "translate-agent-web",
	"main": "web/.open-next/worker.js",
	"build": {
		"command": "test -f web/.open-next/worker.js || npm run build"
	},
	"compatibility_date": "2026-10-22",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": "web/.open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "translate-agent-web"
		}
	],
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	"vars": {
		"TRANSLATOR_MODEL": "z-ai/glm-4.5",
		"MEMORY_MODEL": "qwen/qwen3.5-flash-02-23",
		"COMPACT_MODEL": "qwen/qwen3.5-flash-02-23",
		"ACCESS_TEAM_DOMAIN": "",
		"ACCESS_AUD": ""
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "translate-agent",
			"database_id": "c13f8bc8-693f-400a-9423-78ab1776284d",
			"migrations_dir": "web/drizzle"
		}
	],
	"kv_namespaces": [
		{
			"binding": "FILES",
			"id": "97c573ed60244fe09ba5c28721fb3b1e"
		}
	],
	"previews": {
		"vars": {
			"TRANSLATOR_MODEL": "z-ai/glm-4.5",
			"MEMORY_MODEL": "qwen/qwen3.5-flash-02-23",
			"COMPACT_MODEL": "qwen/qwen3.5-flash-02-23",
			"ACCESS_TEAM_DOMAIN": "fancy-hat-10d0.cloudflareaccess.com",
			"ACCESS_AUD": "3755d009e868a1a8369c6912994344a0e8c62724a4494c8ff9f165b816fbc940"
		},
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "translate-agent",
				"database_id": "c13f8bc8-693f-400a-9423-78ab1776284d"
			}
		],
		"kv_namespaces": [
			{
				"binding": "FILES",
				"id": "97c573ed60244fe09ba5c28721fb3b1e"
			}
		]
	}
}
